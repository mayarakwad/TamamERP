// Tamam data model.
//
// Conventions (keep these when adding models):
// - Every business row carries `orgId`, so one database can hold many workspaces.
// - Money is stored as whole dirhams (1 QAR = 100 dirhams) in Int columns.
//   No floats, no provider-specific decimals: the schema moves to Postgres as-is.
// - "Enums" are plain strings validated in code (src/lib/*), which keeps SQLite
//   and Postgres migrations identical.
// - Bilingual display names use `name` + `nameAr`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ───────────────────────── Platform ─────────────────────────

/// One row (id = 1) describing this installation. Missing row + no users means
/// a fresh install, which sends visitors to the setup wizard.
model SystemSetting {
  id            Int       @id @default(1)
  /// Name shown on the sign-in page and browser tab (white-label)
  instanceName  String    @default("Tamam")
  defaultLocale String    @default("en")
  timezone      String    @default("Asia/Qatar")
  currency      String    @default("QAR")
  /// Anyone may create a workspace from the sign-up page
  allowSignup   Boolean   @default(true)
  /// Demo workspaces are installed (enables the demo accounts on sign-in)
  demoData      Boolean   @default(false)
  /// SHA-256 of the one-time setup key; cleared once installed
  setupKeyHash  String?
  installedAt   DateTime?
  installedById String?
  version       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  nameAr        String?
  passwordHash  String
  phone         String?
  avatarColor   String?
  /// Appearance + language choices. Shape: src/lib/prefs.ts
  preferences   Json?
  lastOrgId     String?
  lastLoginAt   DateTime?
  /// Manages this installation (created by the setup wizard)
  isSystemAdmin Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships   Membership[]
  sessions      Session[]
  notifications Notification[]
  claims        Claim[]        @relation("ClaimSubmitter")
  decisions     Claim[]        @relation("ClaimDecider")
  comments      Comment[]
  files         Attachment[]
}

model Organization {
  id         String   @id @default(cuid())
  /// business | school | home
  type       String
  name       String
  nameAr     String?
  slug       String   @unique
  currency   String   @default("QAR")
  timezone   String   @default("Asia/Qatar")
  /// Language used for printed documents when the reader has no preference
  locale     String   @default("en")
  /// 0 = Sunday … 6 = Saturday
  weekStart  Int      @default(0)
  /// Comma-separated weekday numbers, Qatar default Friday + Saturday
  weekend    String   @default("5,6")
  logoPath   String?
  brandColor String?
  address    String?
  addressAr  String?
  phone      String?
  email      String?
  /// Commercial registration number (businesses) or MoEHE licence (schools)
  crNumber   String?
  isSandbox  Boolean  @default(false)
  settings   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campuses       Campus[]
  memberships    Membership[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  categories     ExpenseCategory[]
  claims         Claim[]
  budgets        Budget[]
  bills          RecurringBill[]
  billPayments   BillPayment[]
  possessions    Possession[]
  comments       Comment[]
  attachments    Attachment[]
  series         NamingSeries[]
  invitations    Invitation[]
  shareLinks     ShareLink[]
  searchIndex    SearchIndex[]
  accounts       Account[]
  journalEntries JournalEntry[]
  journalLines   JournalLine[]
  parties        Party[]
  items          Item[]
  stockLevels    StockLevel[]
  stockMoves     StockMove[]
  documents      Document[]
  documentLines  DocumentLine[]
  payments       Payment[]
  allocations    PaymentAllocation[]
  employees      Employee[]
  attendance     AttendanceDay[]
  leaveRequests  LeaveRequest[]
  payrollRuns    PayrollRun[]
  payslips       Payslip[]
  academicYears  AcademicYear[]
  terms          Term[]
  grades         Grade[]
  subjects       Subject[]
  sections       Section[]
  assignments    TeachingAssignment[]
  timetable      TimetableSlot[]
  guardians      Guardian[]
  students       Student[]
  studentLinks   StudentGuardian[]
  applications   Application[]
  rolls          AttendanceRoll[]
  studentMarks   StudentAttendance[]
  assessments    Assessment[]
  marks          Mark[]
  reportCards    ReportCard[]
  feeRates       FeeRate[]
  routes         BusRoute[]
  stops          BusStop[]
  books          Book[]
  loans          Loan[]
  announcements  Announcement[]
}

/// A campus (schools) or branch (businesses). Optional for homes.
model Campus {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  nameAr    String?
  code      String
  address   String?
  addressAr String?
  color     String?
  createdAt DateTime @default(now())

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberships Membership[]
  stockLevels StockLevel[]
  stockMoves  StockMove[]
  sections    Section[]
  students    Student[]
  applications Application[]
  routes      BusRoute[]

  @@unique([orgId, code])
}

model Membership {
  id               String   @id @default(cuid())
  userId           String
  orgId            String
  /// owner | admin | accountant | teacher | parent | employee | member
  role             String
  /// null = every campus
  campusId         String?
  /// Free-text job title shown in the UI ("Principal", "Head of household")
  title            String?
  titleAr          String?
  /// active | invited | disabled
  status           String   @default("active")
  /// Ordered widget ids + hidden widgets for this person in this workspace
  dashboardLayout  Json?
  /// Comma-separated permissions granted on top of the role (e.g. "inventory.manage")
  extraPermissions String?
  createdAt        DateTime @default(now())

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campus Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@unique([userId, orgId])
  @@index([orgId])
}

model Session {
  /// SHA-256 of the random token kept in the cookie; the raw token is never stored
  id        String   @id
  userId    String
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

/// Who changed what and when. Doubles as each record's activity timeline
/// (filter by entityType + entityId) and as the security log (sensitive = true).
model AuditLog {
  id         String   @id @default(cuid())
  orgId      String?
  userId     String?
  action     String
  entityType String?
  entityId   String?
  summary    String?
  summaryAr  String?
  meta       Json?
  sensitive  Boolean  @default(false)
  ip         String?
  createdAt  DateTime @default(now())

  org Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id        String    @id @default(cuid())
  orgId     String
  userId    String
  kind      String
  title     String
  titleAr   String?
  body      String?
  bodyAr    String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Comment {
  id         String   @id @default(cuid())
  orgId      String
  entityType String
  entityId   String
  authorId   String
  body       String
  createdAt  DateTime @default(now())

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorId], references: [id])

  @@index([entityType, entityId])
}

model Attachment {
  id           String   @id @default(cuid())
  orgId        String
  entityType   String
  entityId     String
  fileName     String
  mimeType     String
  size         Int
  /// Path inside STORAGE_DIR
  path         String
  /// Small preview (images only)
  thumbPath    String?
  /// receipt | photo | file
  kind         String   @default("file")
  width        Int?
  height       Int?
  uploadedById String
  createdAt    DateTime @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  uploadedBy User         @relation(fields: [uploadedById], references: [id])

  @@index([entityType, entityId])
}

/// Document numbering such as CLM-2026-00042
model NamingSeries {
  orgId   String
  key     String
  year    Int
  current Int    @default(0)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, key, year])
}

// ───────────────────────── Home ─────────────────────────

model ExpenseCategory {
  id        String  @id @default(cuid())
  orgId     String
  key       String
  name      String
  nameAr    String
  icon      String
  color     String
  sort      Int     @default(0)
  archived  Boolean @default(false)
  /// Ledger account an approved claim in this category is booked to (businesses, schools)
  accountId String?

  org     Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  claims  Claim[]
  budgets Budget[]
  bills   RecurringBill[]

  @@unique([orgId, key])
}

model Claim {
  id            String    @id @default(cuid())
  orgId         String
  number        String
  submittedById String
  categoryId    String
  /// dirhams
  amount        Int
  merchant      String
  spentOn       DateTime
  note          String?
  /// draft | submitted | approved | rejected | reimbursed
  status        String    @default("submitted")
  /// cash | card | transfer
  paidWith      String    @default("card")
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  reimbursedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  org         Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  submittedBy User            @relation("ClaimSubmitter", fields: [submittedById], references: [id])
  decidedBy   User?           @relation("ClaimDecider", fields: [decidedById], references: [id])
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@unique([orgId, number])
  @@index([orgId, spentOn])
  @@index([orgId, status])
}

/// Monthly budget per category. month = "2026-11"; month = "default" applies
/// to any month without its own row.
model Budget {
  id         String @id @default(cuid())
  orgId      String
  categoryId String
  month      String
  amount     Int

  org      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([orgId, categoryId, month])
}

model RecurringBill {
  id               String   @id @default(cuid())
  orgId            String
  name             String
  nameAr           String?
  provider         String?
  categoryId       String
  /// Typical amount in dirhams; variable bills (electricity) are estimates
  amount           Int
  variable         Boolean  @default(false)
  /// monthly | quarterly | yearly
  frequency        String   @default("monthly")
  nextDue          DateTime
  remindDaysBefore Int      @default(3)
  autopay          Boolean  @default(false)
  active           Boolean  @default(true)
  notes            String?
  createdAt        DateTime @default(now())

  org      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id])
  payments BillPayment[]
}

model BillPayment {
  id         String    @id @default(cuid())
  orgId      String
  billId     String
  dueOn      DateTime
  paidOn     DateTime?
  amount     Int
  /// due | paid | skipped
  status     String    @default("due")
  paidById   String?
  /// When the "due soon" reminder went out (sent once per due date)
  remindedAt DateTime?

  org  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bill RecurringBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([orgId, dueOn])
}

/// Things the household owns, with warranty tracking
model Possession {
  id                 String    @id @default(cuid())
  orgId              String
  name               String
  nameAr             String?
  category           String
  room               String?
  brand              String?
  model              String?
  serial             String?
  purchasedOn        DateTime?
  price              Int?
  store              String?
  warrantyUntil      DateTime?
  /// When the "warranty ending" reminder went out
  warrantyRemindedAt DateTime?
  notes              String?
  createdAt          DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, warrantyUntil])
}

// ───────────────────────── Collaboration & sharing ─────────────────────────

/// An invitation link to join a workspace with a role. Works even when
/// public sign-ups are closed.
model Invitation {
  id          String    @id @default(cuid())
  orgId       String
  email       String
  role        String
  title       String?
  /// SHA-256 of the token in the link
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

/// A view-only link to a frozen copy of a table or report.
model ShareLink {
  id            String    @id @default(cuid())
  orgId         String
  tokenHash     String    @unique
  /// Dataset id (e.g. "claims") the snapshot came from
  dataset       String
  title         String
  /// Columns, rows, branding and locale at the moment of sharing
  snapshot      Json
  allowDownload Boolean   @default(false)
  expiresAt     DateTime?
  revokedAt     DateTime?
  views         Int       @default(0)
  lastViewedAt  DateTime?
  createdById   String
  createdAt     DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

/// One row per searchable record. `text` is lower-cased with Arabic letter
/// forms and diacritics normalized, so "احمد" finds "أحمد".
model SearchIndex {
  id           String   @id @default(cuid())
  orgId        String
  entityType   String
  entityId     String
  title        String
  subtitle     String?
  href         String
  text         String
  /// Only this user (and roles that see everything of this type) may find it
  restrictedTo String?
  updatedAt    DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId])
  @@index([orgId])
}

// ───────────────────────── Accounting ─────────────────────────
//
// Every money event (invoice, payment, bill, stock movement, approved claim,
// payroll) writes a balanced journal entry. Reports read only the journal.

/// Chart of accounts
model Account {
  id        String   @id @default(cuid())
  orgId     String
  code      String
  name      String
  nameAr    String?
  /// asset | liability | equity | income | expense
  type      String
  /// Used by automatic postings: cash, bank, receivable, payable, inventory, grni,
  /// sales, services, cogs, stockAdjust, salaries, salariesPayable, reimbursements,
  /// capital, retained, discounts
  role      String?
  /// Created by Tamam; can be renamed but not deleted
  isSystem  Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  org   Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lines JournalLine[]

  @@unique([orgId, code])
}

model JournalEntry {
  id          String    @id @default(cuid())
  orgId       String
  number      String
  date        DateTime
  memo        String?
  /// manual | opening | invoice | payment | bill | receipt | stock | claim | payroll
  sourceType  String
  sourceId    String?
  /// Set on an entry that cancels another one
  reversesId  String?
  /// Set on an entry that has been cancelled by a reversal
  reversedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  org   Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lines JournalLine[]

  @@unique([orgId, number])
  @@index([orgId, date])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id        String   @id @default(cuid())
  orgId     String
  entryId   String
  accountId String
  /// Same as the entry's date, kept here so reports need no join
  date      DateTime
  /// dirhams; one of debit/credit is zero
  debit     Int      @default(0)
  credit    Int      @default(0)
  /// Customer or supplier, for receivable/payable ledgers
  partyId   String?
  memo      String?

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id])

  @@index([orgId, accountId, date])
  @@index([partyId])
}

// ───────────────────────── Sales, purchases, inventory ─────────────────────────

/// Customers and suppliers. One record can be both.
model Party {
  id           String   @id @default(cuid())
  orgId        String
  name         String
  nameAr       String?
  isCustomer   Boolean  @default(false)
  isSupplier   Boolean  @default(false)
  contactName  String?
  phone        String?
  email        String?
  address      String?
  addressAr    String?
  crNumber     String?
  /// Days until an invoice or bill is due (0 = on receipt)
  paymentTerms Int      @default(30)
  /// dirhams; warn when open invoices would exceed it
  creditLimit  Int?
  notes        String?
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  documents Document[]
  payments  Payment[]

  @@index([orgId])
}

model Item {
  id                String    @id @default(cuid())
  orgId             String
  sku               String
  name              String
  nameAr            String?
  /// product (stock is tracked) | service
  kind              String    @default("product")
  category          String?
  /// pcs, box, ream, carton, set, hour ...
  unit              String    @default("pcs")
  /// dirhams per unit
  salePrice         Int       @default(0)
  purchasePrice     Int       @default(0)
  /// Moving average cost per unit (dirhams), updated on every receipt
  avgCost           Int       @default(0)
  /// Quantities are stored in hundredths (250 = 2.5 units)
  reorderLevel      Int?
  reorderQty        Int?
  barcode           String?
  archived          Boolean   @default(false)
  /// When the low-stock alert went out; cleared when stock is back above the level
  lowStockAlertedAt DateTime?
  createdAt         DateTime  @default(now())

  org    Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  levels StockLevel[]
  moves  StockMove[]
  lines  DocumentLine[]

  @@unique([orgId, sku])
}

/// Quantity on hand per item and warehouse (a business's branches are its warehouses)
model StockLevel {
  id       String @id @default(cuid())
  orgId    String
  itemId   String
  campusId String
  /// hundredths
  qty      Int    @default(0)

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  item   Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  campus Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@unique([itemId, campusId])
}

/// Every change in stock. StockLevel is the running sum of these.
model StockMove {
  id          String   @id @default(cuid())
  orgId       String
  itemId      String
  campusId    String
  date        DateTime
  /// hundredths; positive in, negative out
  qty         Int
  /// dirhams per unit
  unitCost    Int
  /// opening | receipt | sale | adjustment | transfer
  kind        String
  sourceType  String?
  sourceId    String?
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  item   Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  campus Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@index([orgId, itemId, date])
  @@index([sourceType, sourceId])
}

/// Quotations, invoices, purchase orders and supplier bills share one shape.
model Document {
  id          String    @id @default(cuid())
  orgId       String
  /// quote | invoice | po | bill
  kind        String
  number      String
  partyId     String
  /// Branch that sells (invoices) or warehouse that receives (POs, bills)
  campusId    String?
  date        DateTime
  /// Invoices and bills: payment due. Quotes: valid until. POs: expected delivery.
  dueDate     DateTime?
  /// quote: draft | sent | accepted | declined | converted
  /// invoice: draft | issued | partial | paid | void
  /// po: draft | sent | partial | received | billed | cancelled
  /// bill: draft | posted | partial | paid | void
  status      String    @default("draft")
  /// Customer's PO number, or the supplier's own invoice number
  reference   String?
  notes       String?
  terms       String?
  subtotal    Int       @default(0)
  discount    Int       @default(0)
  total       Int       @default(0)
  /// Paid so far (sum of payment allocations)
  paid        Int       @default(0)
  /// Created from (quote → invoice, purchase order → bill)
  sourceId    String?
  /// School fee invoices: the student the fees are for
  studentId   String?
  /// School fee invoices: academic year and installment ("2026-27/2")
  installment String?
  createdById String
  issuedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org         Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  party       Party               @relation(fields: [partyId], references: [id])
  lines       DocumentLine[]
  allocations PaymentAllocation[]
  student     Student?            @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@unique([orgId, number])
  @@index([orgId, kind, status])
  @@index([studentId])
  @@index([partyId])
}

model DocumentLine {
  id          String  @id @default(cuid())
  orgId       String
  documentId  String
  sort        Int     @default(0)
  itemId      String?
  description String
  /// hundredths
  qty         Int
  /// dirhams per unit
  unitPrice   Int
  /// basis points (1000 = 10%)
  discountPct Int     @default(0)
  /// dirhams, after discount
  amount      Int
  /// Bills without an item: the expense account to book to
  accountId   String?
  /// Purchase orders: quantity received so far (hundredths)
  received    Int     @default(0)

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  document Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  item     Item?        @relation(fields: [itemId], references: [id])
}

/// Money received from customers (in) or paid to suppliers (out)
model Payment {
  id          String    @id @default(cuid())
  orgId       String
  number      String
  /// in | out
  direction   String
  partyId     String
  date        DateTime
  amount      Int
  /// cash | transfer | cheque | card
  method      String
  /// The cash or bank account the money went into or came out of
  accountId   String
  reference   String?
  notes       String?
  createdById String
  voidedAt    DateTime?
  createdAt   DateTime  @default(now())

  org         Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  party       Party               @relation(fields: [partyId], references: [id])
  allocations PaymentAllocation[]

  @@unique([orgId, number])
  @@index([orgId, date])
}

model PaymentAllocation {
  id         String @id @default(cuid())
  orgId      String
  paymentId  String
  documentId String
  amount     Int

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  payment  Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  document Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

// ───────────────────────── People ─────────────────────────

model Employee {
  id                 String    @id @default(cuid())
  orgId              String
  number             String
  /// The person's Tamam login, if they have one (for self-service)
  userId             String?
  name               String
  nameAr             String?
  jobTitle           String?
  jobTitleAr         String?
  department         String?
  campusId           String?
  /// ISO 3166 alpha-2
  nationality        String?
  phone              String?
  email              String?
  /// Qatar ID (11 digits)
  qid                String?
  qidExpiry          DateTime?
  /// For new arrivals who don't have a QID yet (WPS accepts it instead)
  visaNumber         String?
  passportNumber     String?
  passportExpiry     DateTime?
  joinedOn           DateTime
  leftOn             DateTime?
  /// active | terminated
  status             String    @default("active")
  /// Monthly amounts in dirhams
  basicSalary        Int
  housingAllowance   Int       @default(0)
  transportAllowance Int       @default(0)
  foodAllowance      Int       @default(0)
  otherAllowance     Int       @default(0)
  /// bank | cash
  payMethod          String    @default("bank")
  /// WPS bank short name (QNB, CBQ, DBQ ...)
  bankShortName      String?
  iban               String?
  /// Days of paid annual leave per year (Qatar: at least 21, 28 after five years)
  annualLeaveDays    Int       @default(21)
  /// Leave days carried in when the record was created
  leaveOpening       Int       @default(0)
  qidRemindedAt      DateTime?
  passportRemindedAt DateTime?
  notes              String?
  createdAt          DateTime  @default(now())

  org        Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  attendance AttendanceDay[]
  leave      LeaveRequest[]
  payslips   Payslip[]
  homerooms  Section[]
  teaching   TeachingAssignment[]
  periods    TimetableSlot[]
  loans      Loan[]

  @@unique([orgId, number])
}

model AttendanceDay {
  id          String   @id @default(cuid())
  orgId       String
  employeeId  String
  /// Noon in Doha on the calendar day
  date        DateTime
  /// present | late | absent | leave | sick | holiday
  status      String
  /// "07:58"
  checkIn     String?
  checkOut    String?
  overtimeMin Int      @default(0)
  note        String?

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([orgId, date])
}

model LeaveRequest {
  id            String    @id @default(cuid())
  orgId         String
  number        String
  employeeId    String
  /// annual | sick | unpaid | emergency | maternity | hajj
  type          String
  startDate     DateTime
  endDate       DateTime
  /// Working days covered
  days          Int
  reason        String?
  /// submitted | approved | rejected | cancelled
  status        String    @default("submitted")
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime  @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([orgId, number])
  @@index([orgId, status])
}

model PayrollRun {
  id              String    @id @default(cuid())
  orgId           String
  /// "2026-11"
  month           String
  /// draft | approved | paid
  status          String    @default("draft")
  totalGross      Int       @default(0)
  totalDeductions Int       @default(0)
  totalNet        Int       @default(0)
  payDate         DateTime?
  createdById     String
  approvedById    String?
  approvedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  payslips Payslip[]

  @@unique([orgId, month])
}

model Payslip {
  id               String  @id @default(cuid())
  orgId            String
  runId            String
  employeeId       String
  /// Days paid in the month (out of 30)
  workingDays      Int
  absentDays       Int     @default(0)
  unpaidLeaveDays  Int     @default(0)
  basic            Int
  housing          Int     @default(0)
  transport        Int     @default(0)
  food             Int     @default(0)
  other            Int     @default(0)
  /// hundredths of an hour
  overtimeHours    Int     @default(0)
  overtimePay      Int     @default(0)
  bonus            Int     @default(0)
  absenceDeduction Int     @default(0)
  advanceDeduction Int     @default(0)
  otherDeduction   Int     @default(0)
  /// WPS deduction reason code (01, 02, 03, 04, 99)
  deductionCode    String?
  gross            Int
  deductions       Int
  net              Int
  notes            String?

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run      PayrollRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([runId, employeeId])
}

// ───────────────────────── School ─────────────────────────

model AcademicYear {
  id        String   @id @default(cuid())
  orgId     String
  /// "2026–27"
  name      String
  startDate DateTime
  endDate   DateTime
  /// The year the app shows by default
  current   Boolean  @default(false)
  createdAt DateTime @default(now())

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  terms        Term[]
  sections     Section[]
  applications Application[]
  feeRates     FeeRate[]

  @@unique([orgId, name])
}

model Term {
  id        String   @id @default(cuid())
  orgId     String
  yearId    String
  name      String
  nameAr    String?
  sort      Int
  startDate DateTime
  endDate   DateTime

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  year        AcademicYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
  assessments Assessment[]
  reportCards ReportCard[]

  @@index([yearId])
}

/// A year group: KG1, KG2, Grade 1 … Grade 12. Shared by every campus.
model Grade {
  id     String  @id @default(cuid())
  orgId  String
  name   String
  nameAr String?
  /// Order: KG1 = -1, KG2 = 0, Grade 1 = 1 …
  level  Int
  /// kg | primary | middle | secondary
  stage  String

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sections     Section[]
  students     Student[]
  applications Application[]
  feeRates     FeeRate[]

  @@unique([orgId, level])
}

model Subject {
  id     String  @id @default(cuid())
  orgId  String
  code   String
  name   String
  nameAr String?
  color  String?
  sort   Int     @default(0)

  org         Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignments TeachingAssignment[]
  slots       TimetableSlot[]
  assessments Assessment[]

  @@unique([orgId, code])
}

/// A class: one grade at one campus in one year ("5-B").
model Section {
  id         String  @id @default(cuid())
  orgId      String
  yearId     String
  campusId   String
  gradeId    String
  /// The letter or name after the grade: "B" shows as "5-B"
  name       String
  room       String?
  capacity   Int     @default(25)
  /// Homeroom (class) teacher
  homeroomId String?

  org         Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  year        AcademicYear         @relation(fields: [yearId], references: [id], onDelete: Cascade)
  campus      Campus               @relation(fields: [campusId], references: [id], onDelete: Cascade)
  grade       Grade                @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  homeroom    Employee?            @relation(fields: [homeroomId], references: [id], onDelete: SetNull)
  students    Student[]
  assignments TeachingAssignment[]
  slots       TimetableSlot[]
  rolls       AttendanceRoll[]
  absences    StudentAttendance[]
  assessments Assessment[]
  reportCards ReportCard[]

  @@unique([yearId, campusId, gradeId, name])
  @@index([orgId, yearId])
}

/// Who teaches which subject to which class, and how many periods a week.
model TeachingAssignment {
  id        String  @id @default(cuid())
  orgId     String
  sectionId String
  subjectId String
  teacherId String?
  periods   Int     @default(4)

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  section Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Employee?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([sectionId, subjectId])
  @@index([teacherId])
}

model TimetableSlot {
  id        String  @id @default(cuid())
  orgId     String
  sectionId String
  /// 0 = Sunday … 6 = Saturday
  day       Int
  /// 1-based period number (times are in the school settings)
  period    Int
  subjectId String
  teacherId String?
  room      String?

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  section Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Employee?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([sectionId, day, period])
  @@index([teacherId, day, period])
}

model Guardian {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  nameAr    String?
  phone     String?
  email     String?
  qid       String?
  employer  String?
  address   String?
  addressAr String?
  /// The guardian's Tamam login, for the parent view
  userId    String?
  /// Fee invoices for this family are addressed to this account
  partyId   String?
  createdAt DateTime @default(now())

  org          Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  children     StudentGuardian[]
  applications Application[]

  @@index([orgId])
  @@index([userId])
}

model Student {
  id             String    @id @default(cuid())
  orgId          String
  /// Admission number
  number         String
  name           String
  nameAr         String?
  /// m | f
  gender         String
  dob            DateTime
  /// ISO 3166 alpha-2
  nationality    String?
  qid            String?
  qidExpiry      DateTime?
  passportNumber String?
  campusId       String
  gradeId        String
  sectionId      String?
  /// active | upcoming (joins next year) | withdrawn | graduated
  status         String    @default("active")
  joinedOn       DateTime
  leftOn         DateTime?
  bloodGroup     String?
  /// Allergies, conditions, medication. Teachers see a flag.
  medical        String?
  busStopId      String?
  /// Fee discount on tuition besides siblings: staff | scholarship
  discountKind   String?
  /// basis points (5000 = 50%)
  discountPct    Int       @default(0)
  previousSchool String?
  avatarColor    String?
  notes          String?
  createdAt      DateTime  @default(now())

  org         Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campus      Campus              @relation(fields: [campusId], references: [id])
  grade       Grade               @relation(fields: [gradeId], references: [id])
  section     Section?            @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  busStop     BusStop?            @relation(fields: [busStopId], references: [id], onDelete: SetNull)
  guardians   StudentGuardian[]
  attendance  StudentAttendance[]
  marks       Mark[]
  reportCards ReportCard[]
  loans       Loan[]
  invoices    Document[]

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([sectionId])
}

model StudentGuardian {
  id         String  @id @default(cuid())
  orgId      String
  studentId  String
  guardianId String
  /// father | mother | guardian | grandparent | other
  relation   String
  /// Pays the fees and receives the invoices
  primary    Boolean @default(false)

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  student  Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian     @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([guardianId])
}

/// Admissions: from application to enrolment.
model Application {
  id               String    @id @default(cuid())
  orgId            String
  number           String
  yearId           String
  campusId         String
  gradeId          String
  childName        String
  childNameAr      String?
  gender           String
  dob              DateTime
  nationality      String?
  previousSchool   String?
  guardianName     String
  guardianNameAr   String?
  guardianRelation String    @default("father")
  guardianPhone    String
  guardianEmail    String?
  /// A family already at the school (siblings)
  guardianId       String?
  /// applied | assessment | offered | enrolled | declined | withdrawn
  stage            String    @default("applied")
  stageAt          DateTime  @default(now())
  assessmentAt     DateTime?
  /// percent
  assessmentScore  Int?
  /// web | walkin | referral | sibling
  source           String    @default("walkin")
  notes            String?
  studentId        String?
  /// null when the family applied through the public form
  createdById      String?
  createdAt        DateTime  @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  year     AcademicYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
  campus   Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  grade    Grade        @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  guardian Guardian?    @relation(fields: [guardianId], references: [id], onDelete: SetNull)

  @@unique([orgId, number])
  @@index([orgId, stage])
}

/// One roll call: a class on a day. Everyone without a StudentAttendance row was present.
model AttendanceRoll {
  id        String   @id @default(cuid())
  orgId     String
  sectionId String
  /// Noon in Doha on the school day
  date      DateTime
  takenById String
  takenAt   DateTime @default(now())
  /// Students on the roll that day
  size      Int
  absent    Int      @default(0)
  late      Int      @default(0)
  excused   Int      @default(0)

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  section Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, date])
  @@index([orgId, date])
}

/// Exceptions only: absences, late arrivals and excused days.
model StudentAttendance {
  id         String    @id @default(cuid())
  orgId      String
  studentId  String
  sectionId  String
  date       DateTime
  /// absent | late | excused
  status     String
  /// Minutes late
  minutes    Int?
  note       String?
  notifiedAt DateTime?

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([orgId, date])
}

/// Anything marked: an exam paper, a quiz, an assignment or a project.
model Assessment {
  id          String   @id @default(cuid())
  orgId       String
  termId      String
  sectionId   String
  subjectId   String
  name        String
  nameAr      String?
  /// exam | quiz | assignment | project
  kind        String
  date        DateTime
  /// Marked out of
  maxScore    Int
  /// Share of the term grade (weights in a term are scaled to 100)
  weight      Int
  createdById String?
  createdAt   DateTime @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  term    Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  section Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  marks   Mark[]

  @@index([sectionId, subjectId, termId])
  @@index([orgId, termId])
}

model Mark {
  id           String   @id @default(cuid())
  orgId        String
  assessmentId String
  studentId    String
  /// hundredths of a mark (8550 = 85.5)
  score        Int?
  absent       Boolean  @default(false)
  comment      String?
  updatedAt    DateTime @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assessment Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@index([studentId])
}

model ReportCard {
  id               String    @id @default(cuid())
  orgId            String
  studentId        String
  termId           String
  /// The class at the time (null for imported history; the snapshot keeps its name)
  sectionId        String?
  /// draft | published
  status           String    @default("draft")
  teacherComment   String?
  principalComment String?
  /// { [subjectId]: comment }
  subjectComments  Json?
  /// Frozen when published: subjects, results and attendance
  snapshot         Json?
  publishedAt      DateTime?
  publishedById    String?
  updatedAt        DateTime  @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term    Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  section Section?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@unique([studentId, termId])
  @@index([sectionId, termId])
}

/// Yearly fees per grade: tuition | books | registration (new students only)
model FeeRate {
  id        String @id @default(cuid())
  orgId     String
  yearId    String
  gradeId   String
  component String
  /// dirhams per year
  amount    Int

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  year  AcademicYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
  grade Grade        @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@unique([yearId, gradeId, component])
}

model BusRoute {
  id             String  @id @default(cuid())
  orgId          String
  campusId       String
  /// "Bus 4"
  code           String
  name           String
  nameAr         String?
  driverName     String?
  driverPhone    String?
  attendantName  String?
  attendantPhone String?
  plate          String?
  capacity       Int     @default(30)
  /// Yearly transport fee in dirhams
  annualFee      Int     @default(0)
  color          String?

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campus Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  stops  BusStop[]

  @@unique([orgId, code])
}

model BusStop {
  id      String  @id @default(cuid())
  orgId   String
  routeId String
  name    String
  nameAr  String?
  sort    Int
  /// "06:42"
  pickup  String?
  dropoff String?

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  route    BusRoute     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  students Student[]

  @@index([routeId])
}

model Book {
  id         String   @id @default(cuid())
  orgId      String
  campusId   String?
  title      String
  author     String?
  isbn       String?
  /// en | ar | fr | other
  language   String   @default("en")
  category   String?
  shelf      String?
  copies     Int      @default(1)
  coverColor String?
  createdAt  DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  loans Loan[]

  @@index([orgId])
}

model Loan {
  id         String    @id @default(cuid())
  orgId      String
  bookId     String
  studentId  String?
  employeeId String?
  borrowedOn DateTime
  dueOn      DateTime
  returnedOn DateTime?
  remindedAt DateTime?
  issuedById String

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  book     Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student  Student?     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  employee Employee?    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([orgId, returnedOn])
  @@index([bookId])
}

model Announcement {
  id          String   @id @default(cuid())
  orgId       String
  /// null = every campus
  campusId    String?
  /// everyone | staff | parents
  audience    String   @default("everyone")
  /// Parents of one grade only
  gradeId     String?
  title       String
  titleAr     String?
  body        String
  bodyAr      String?
  pinned      Boolean  @default(false)
  authorId    String
  publishedAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, publishedAt])
}
