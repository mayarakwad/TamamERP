# Copy to .env and adjust. Never commit .env.

# SQLite file (relative to the project root). For Postgres later:
# DATABASE_URL="postgresql://user:pass@host:5432/tamam"
DATABASE_URL="file:./data/tamam.db"

# 32+ random bytes, base64. Used to encrypt organization AI keys (stage 4)
# and to sign share links. Generate with:  openssl rand -base64 32
APP_SECRET="change-me-to-a-long-random-string"

# Where uploaded files (receipts, logos, wallpapers) are stored
STORAGE_DIR="./storage"
